# =============================================================================
# CONFIGURAÇÕES DE PRODUÇÃO - MEU NEGÓCIO (WHATSAPP BUSINESS CLOUD API)
# =============================================================================
# Modelo de referência (.env.example).
# Configure estas variáveis no seu painel de hospedagem (ex: Google Cloud Run,
# Firebase Cloud Functions ou arquivo .env do backend).
# NUNCA insira esses dados no aplicativo Android.
# =============================================================================

PORT=8080
NODE_ENV=production

# -----------------------------------------------------------------------------
# 1. CREDENCIAIS OFICIAIS DA META (WhatsApp Business Platform)
# Obtidas no portal: https://developers.facebook.com/apps/
# -----------------------------------------------------------------------------

# ID do Aplicativo na Meta (Meta Developers > Painel)
META_APP_ID=

# Chave Secreta do Aplicativo (Meta Developers > Configurações do App > Básico)
# Usada para validação estrita HMAC-SHA256 do cabeçalho X-Hub-Signature-256
META_APP_SECRET=

# Token de Acesso Permanente (System User Token com escopo whatsapp_business_messaging)
META_ACCESS_TOKEN=

# Token de Verificação do Webhook (Crie uma senha forte e coloque o mesmo valor na Meta)
META_VERIFY_TOKEN=meu_negocio_webhook_token_seguro_2026

# ID do Número de Telefone (Meta Developers > WhatsApp > Início Rápido / Configuração da API)
META_PHONE_NUMBER_ID=

# ID da Conta do WhatsApp Business (WABA ID)
META_WABA_ID=

# Versão da Meta Graph API (Versão estável atual)
META_API_VERSION=v21.0

# URL Pública do Backend (HTTPS) onde este servidor estará respondendo na nuvem
# Usada para servir PDFs de comprovantes e relatórios quando necessário
# Exemplo: https://meu-negocio-backend-xpto.a.run.app
PUBLIC_BACKEND_URL=

# -----------------------------------------------------------------------------
# 2. INTEGRAÇÃO COM FIREBASE / FIRESTORE
# -----------------------------------------------------------------------------
# No Cloud Run ou Cloud Functions, a autenticação com o Firestore ocorre via
# Application Default Credentials (ADC) automaticamente.
FIREBASE_PROJECT_ID=meu-negocio-ffdd3
FIREBASE_STORAGE_BUCKET=

# -----------------------------------------------------------------------------
# 3. MOTOR DE INTELIGÊNCIA ARTIFICIAL (GOOGLE GEMINI)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
